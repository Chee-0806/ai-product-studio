#!/bin/sh
# 启用：npm run hooks
# 只检查 PRD / 原型 / 状态文件相关的改动，纯文档改动不阻塞。
changed=$(git diff --cached --name-only --diff-filter=ACMR)
if echo "$changed" | grep -Eq '^(product|prototype|docs)/|^STATE\.md$'; then
  node scripts/sync.mjs --check --strict || {
    echo ""
    echo "提交被拦截：PRD 与原型不一致。运行 npm run sync 生成目录页并修复上述错误。"
    exit 1
  }
fi
